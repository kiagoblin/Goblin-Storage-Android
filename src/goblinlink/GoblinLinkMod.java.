package goblinlink;

import mindustry.mod.Mod;
import mindustry.content.Blocks;
import mindustry.content.TechTree;
import static mindustry.type.ItemStack.with;
import mindustry.content.Items;
import mindustry.world.Block;

public class GoblinLinkMod extends Mod {

    // Объявляем ваш блок здесь, чтобы он инициализировался при загрузке мода
    public static Block goblinLinkBlock;

    public GoblinLinkMod() {
    }

    @Override
    public void loadContent() {
        super.loadContent();

        // Инициализируем блок (убедитесь, что имя совпадает со спрайтом)
        goblinLinkBlock = new GoblinLinkBlock("goblin-link");

        // Добавляем в дерево технологий после кремниевой плавильни (silicon-smelter)
        TechTree.node(Blocks.siliconSmelter, goblinLinkBlock, () -> {
            node.requirements = with(
                Items.silicon, 250,
                Items.lead, 200,
                Items.copper, 400
            );
        });

}
}
